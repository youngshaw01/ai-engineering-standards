{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youngshaw01/ai-engineering-standards/contract/project-config.schema.json",
  "title": "HarnessProjectConfigV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "standards"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "displayName": {
      "type": "string"
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version"],
      "properties": {
        "repository": {
          "type": "string",
          "const": "ai-engineering-standards"
        },
        "version": {
          "type": "string",
          "description": "Layer 0 VERSION at adoption time"
        },
        "contract": {
          "type": "string",
          "const": "contract/harness-contract.md"
        }
      }
    },
    "adoptedAt": {
      "type": "string",
      "format": "date"
    }
  }
}
