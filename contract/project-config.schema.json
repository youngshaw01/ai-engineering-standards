{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/youngshaw01/ai-engineering-standards/contract/project-config.schema.json",
  "title": "HarnessProjectConfigV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "vcs", "standards"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "3.0.0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "vcs": {
      "type": "string",
      "enum": ["git", "svn"]
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version"],
      "properties": {
        "repository": {
          "type": "string",
          "const": "ai-engineering-standards"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "type": "string",
          "const": "contract/harness-contract.md"
        }
      }
    },
    "adoptedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
